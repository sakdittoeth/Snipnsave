<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Package visibility, required from Android 11. Without it
      CustomTabsClient.getPackageName() can see no browsers at all, the intent
      goes out unpinned, and any app claiming the host — the Substack app, in
      practice — can take the link and drop its text fragment.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Snips">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The one sheet all three §4 entry points converge on.

          §4a (Chrome "Link to highlight") and §4c (share sheet) both arrive
          as ACTION_SEND text/plain; they are told apart by whether the URL
          carries a #:~:text= fragment, not by the filter.

          The step 1 intent dump is still registered against these same
          actions in src/debug — see that manifest.
        -->
        <activity
            android:name=".capture.CaptureActivity"
            android:exported="true"
            android:label="@string/capture_label"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:launchMode="singleTask">

            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- §4b: puts Snips in the floating text-selection toolbar system-wide. -->
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

    </application>

</manifest>
